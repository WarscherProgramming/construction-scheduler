DATABASE_URL=postgresql://postgres:password@localhost:5432/scheduler_db
APP_ENV=development
APP_DEBUG=false
# Required: replace this placeholder with at least 32 random characters.
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://construction-scheduler-eight.vercel.app
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ISSUER=fieldflow-api
JWT_AUDIENCE=fieldflow-web
# Optional dedicated secret; when empty, a domain-separated key is derived
# from SECRET_KEY. Production should set an independent 32+ character value.
REFRESH_TOKEN_SECRET=
REFRESH_COOKIE_NAME=fieldflow_refresh
CSRF_COOKIE_NAME=fieldflow_csrf
# Local HTTP uses false/lax. Cross-site production requires true/none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_PATH=/auth
REFRESH_SESSION_CLEANUP_BATCH_SIZE=100
REFRESH_SESSION_RETENTION_DAYS=30

# Includes 25 MiB file size plus 1 MiB multipart overhead.
# Keep an equivalent or stricter request limit at the deployment proxy.
MAX_REQUEST_BODY_BYTES=27262976
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_SECONDS=300
AUTH_REGISTER_RATE_LIMIT=3
AUTH_REGISTER_RATE_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_MAX_ENTRIES=10000

# Shared attachment and Document storage (legacy prefix kept for compatibility)
ATTACHMENT_STORAGE_PROVIDER=local
ATTACHMENT_LOCAL_STORAGE_ROOT=
ATTACHMENT_MAX_UPLOAD_SIZE=26214400
ATTACHMENT_UPLOAD_CHUNK_SIZE=65536
# Optional comma-separated override. Defaults include PDF, JPEG, PNG, WebP,
# HEIC/HEIF, plain text, CSV, Word, and Excel MIME types.
# ATTACHMENT_PERMITTED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_REGION=us-east-1
ATTACHMENT_S3_ENDPOINT_URL=
ATTACHMENT_S3_ACCESS_KEY_ID=
ATTACHMENT_S3_SECRET_ACCESS_KEY=
ATTACHMENT_S3_SESSION_TOKEN=
ATTACHMENT_S3_ADDRESSING_STYLE=auto
ATTACHMENT_S3_SECURE_TRANSPORT=true
ATTACHMENT_S3_CONNECT_TIMEOUT=5
ATTACHMENT_S3_READ_TIMEOUT=60
ATTACHMENT_S3_MAX_RETRIES=3
ATTACHMENT_S3_KEY_PREFIX=fieldflow/attachments
ATTACHMENT_CLEANUP_BATCH_SIZE=100
ATTACHMENT_CLEANUP_MAX_ATTEMPTS=8
ATTACHMENT_CLEANUP_RETRY_BASE_SECONDS=30
ATTACHMENT_CLEANUP_RETRY_MAX_SECONDS=3600
ATTACHMENT_CLEANUP_LEASE_SECONDS=900
ATTACHMENT_CLEANUP_RETENTION_DAYS=30

# Document text extraction and search
DOCUMENT_EXTRACTION_ENABLED=true
# Native PDF text extraction is production-ready. OCR remains disabled until
# a deployable provider is deliberately configured and implemented.
DOCUMENT_OCR_ENABLED=false
DOCUMENT_OCR_PROVIDER=disabled
DOCUMENT_OCR_LANGUAGE=eng
DOCUMENT_EXTRACTION_MAX_PAGES=500
DOCUMENT_OCR_MAX_PAGES=50
DOCUMENT_EXTRACTION_MAX_CHARS_PER_PAGE=100000
DOCUMENT_EXTRACTION_MAX_CHARS_PER_DOCUMENT=2000000
DOCUMENT_EXTRACTION_EMBEDDED_TEXT_THRESHOLD=20
DOCUMENT_OCR_DPI=200
DOCUMENT_OCR_MAX_PIXELS=40000000
DOCUMENT_OCR_MAX_DIMENSION=12000
DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=120
DOCUMENT_OCR_PAGE_TIMEOUT_SECONDS=30
DOCUMENT_EXTRACTION_MAX_ATTEMPTS=3
DOCUMENT_EXTRACTION_RETRY_BASE_SECONDS=60
DOCUMENT_EXTRACTION_RETRY_MAX_SECONDS=3600
DOCUMENT_EXTRACTION_LEASE_SECONDS=900
DOCUMENT_EXTRACTION_BATCH_SIZE=10
DOCUMENT_EXTRACTION_RETENTION_DAYS=30
DOCUMENT_EXTRACTION_REPROCESS_RATE_LIMIT=5
DOCUMENT_EXTRACTION_REPROCESS_RATE_WINDOW_SECONDS=3600
