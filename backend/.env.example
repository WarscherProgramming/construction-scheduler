DATABASE_URL=postgresql://postgres:password@localhost:5432/scheduler_db
APP_ENV=development
APP_DEBUG=false
# Required: replace this placeholder with at least 32 random characters.
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://construction-scheduler-eight.vercel.app
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ISSUER=fieldflow-api
JWT_AUDIENCE=fieldflow-web
# Optional dedicated secret; when empty, a domain-separated key is derived
# from SECRET_KEY. Production should set an independent 32+ character value.
REFRESH_TOKEN_SECRET=
REFRESH_COOKIE_NAME=fieldflow_refresh
CSRF_COOKIE_NAME=fieldflow_csrf
# Local HTTP uses false/lax. Cross-site production requires true/none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_PATH=/auth
REFRESH_SESSION_CLEANUP_BATCH_SIZE=100
REFRESH_SESSION_RETENTION_DAYS=30

# Includes 25 MiB file size plus 1 MiB multipart overhead.
# Keep an equivalent or stricter request limit at the deployment proxy.
MAX_REQUEST_BODY_BYTES=27262976
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_SECONDS=300
AUTH_REGISTER_RATE_LIMIT=3
AUTH_REGISTER_RATE_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_MAX_ENTRIES=10000

# Shared attachment and Document storage (legacy prefix kept for compatibility)
ATTACHMENT_STORAGE_PROVIDER=local
ATTACHMENT_LOCAL_STORAGE_ROOT=
ATTACHMENT_MAX_UPLOAD_SIZE=26214400
ATTACHMENT_UPLOAD_CHUNK_SIZE=65536
# Optional comma-separated override. Defaults include PDF, JPEG, PNG, WebP,
# HEIC/HEIF, plain text, CSV, Word, and Excel MIME types.
# ATTACHMENT_PERMITTED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_REGION=us-east-1
ATTACHMENT_S3_ENDPOINT_URL=
ATTACHMENT_S3_ACCESS_KEY_ID=
ATTACHMENT_S3_SECRET_ACCESS_KEY=
ATTACHMENT_S3_SESSION_TOKEN=
ATTACHMENT_S3_ADDRESSING_STYLE=auto
ATTACHMENT_S3_SECURE_TRANSPORT=true
ATTACHMENT_S3_CONNECT_TIMEOUT=5
ATTACHMENT_S3_READ_TIMEOUT=60
ATTACHMENT_S3_MAX_RETRIES=3
ATTACHMENT_S3_KEY_PREFIX=fieldflow/attachments
ATTACHMENT_CLEANUP_BATCH_SIZE=100
ATTACHMENT_CLEANUP_MAX_ATTEMPTS=8
ATTACHMENT_CLEANUP_RETRY_BASE_SECONDS=30
ATTACHMENT_CLEANUP_RETRY_MAX_SECONDS=3600
ATTACHMENT_CLEANUP_LEASE_SECONDS=900
ATTACHMENT_CLEANUP_RETENTION_DAYS=30

# Document text extraction and search
DOCUMENT_EXTRACTION_ENABLED=true
# Native PDF text extraction is production-ready. OCR remains disabled until
# a deployable provider is deliberately configured and implemented.
DOCUMENT_OCR_ENABLED=false
DOCUMENT_OCR_PROVIDER=disabled
DOCUMENT_OCR_LANGUAGE=eng
DOCUMENT_EXTRACTION_MAX_PAGES=500
DOCUMENT_OCR_MAX_PAGES=50
DOCUMENT_EXTRACTION_MAX_CHARS_PER_PAGE=100000
DOCUMENT_EXTRACTION_MAX_CHARS_PER_DOCUMENT=2000000
DOCUMENT_EXTRACTION_EMBEDDED_TEXT_THRESHOLD=20
DOCUMENT_OCR_DPI=200
DOCUMENT_OCR_MAX_PIXELS=40000000
DOCUMENT_OCR_MAX_DIMENSION=12000
DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=120
DOCUMENT_OCR_PAGE_TIMEOUT_SECONDS=30
DOCUMENT_EXTRACTION_MAX_ATTEMPTS=3
DOCUMENT_EXTRACTION_RETRY_BASE_SECONDS=60
DOCUMENT_EXTRACTION_RETRY_MAX_SECONDS=3600
DOCUMENT_EXTRACTION_LEASE_SECONDS=900
DOCUMENT_EXTRACTION_BATCH_SIZE=10
DOCUMENT_EXTRACTION_RETENTION_DAYS=30
DOCUMENT_EXTRACTION_REPROCESS_RATE_LIMIT=5
DOCUMENT_EXTRACTION_REPROCESS_RATE_WINDOW_SECONDS=3600

# AI preconstruction foundation. No live provider ships in M18.1.
PRECONSTRUCTION_AI_ENABLED=false
PRECONSTRUCTION_AI_PROVIDER=disabled
PRECONSTRUCTION_AI_MODEL=disabled
PRECONSTRUCTION_AI_MAX_ATTEMPTS=3
PRECONSTRUCTION_AI_LEASE_SECONDS=300
PRECONSTRUCTION_AI_BATCH_SIZE=5
PRECONSTRUCTION_AI_MAX_SOURCES_PER_REVIEW=250
PRECONSTRUCTION_AI_MAX_MANIFEST_BYTES=262144
PRECONSTRUCTION_AI_MAX_RESULT_BYTES=32768
PRECONSTRUCTION_AI_RETRY_BASE_SECONDS=30
PRECONSTRUCTION_AI_RETRY_MAX_SECONDS=3600
PRECONSTRUCTION_AI_FAKE_PROVIDER_ALLOWED=false

# Immutable source-content preparation. This snapshots existing native PDF
# extraction only; production OCR and live AI remain disabled.
PRECONSTRUCTION_PREPARATION_MAX_PAGES=500
PRECONSTRUCTION_PREPARATION_MAX_SEGMENTS=5000
PRECONSTRUCTION_PREPARATION_MAX_TOTAL_CHARACTERS=2000000
PRECONSTRUCTION_PREPARATION_MAX_SEGMENT_CHARACTERS=4000
PRECONSTRUCTION_PREPARATION_BATCH_SIZE=5
PRECONSTRUCTION_PREPARATION_LEASE_SECONDS=300
PRECONSTRUCTION_PREPARATION_MAX_ATTEMPTS=3
PRECONSTRUCTION_PREPARATION_RETRY_BASE_SECONDS=30
PRECONSTRUCTION_PREPARATION_RETRY_MAX_SECONDS=3600
PRECONSTRUCTION_CONTENT_PAGE_SIZE=25
PRECONSTRUCTION_CONTENT_MAX_RESPONSE_CHARACTERS=100000

# Construction scope assertions. The taxonomy is a versioned built-in constant;
# there is no taxonomy credential, editing API, or live provider. Every
# assertion requires human review before it is treated as accepted.
PRECONSTRUCTION_SCOPE_MAX_ASSERTIONS_PER_RUN=500
PRECONSTRUCTION_SCOPE_MAX_EVIDENCE_PER_ASSERTION=10
PRECONSTRUCTION_SCOPE_MAX_EVIDENCE_PER_RESULT=2000
PRECONSTRUCTION_SCOPE_MAX_SUBJECT_CHARACTERS=300
PRECONSTRUCTION_SCOPE_MAX_REQUIREMENT_CHARACTERS=2000
PRECONSTRUCTION_SCOPE_MAX_REVIEWER_NOTE_CHARACTERS=2000
PRECONSTRUCTION_SCOPE_MAX_MANUAL_ASSERTIONS=500
PRECONSTRUCTION_SCOPE_ASSERTION_PAGE_SIZE=25
PRECONSTRUCTION_SCOPE_ASSERTION_MAX_PAGE_SIZE=100
PRECONSTRUCTION_SCOPE_TAXONOMY_SEARCH_LIMIT=100
PRECONSTRUCTION_SCOPE_REQUEST_MAX_CONTENT_CHARACTERS=100000
PRECONSTRUCTION_SCOPE_MAX_RESULT_BYTES=1048576
PRECONSTRUCTION_SCOPE_EVIDENCE_EXCERPT_CHARACTERS=600

# Cross-document scope comparison. Deterministic comparison requires no AI
# provider and remains available in production; provider validation is
# optional and stays disabled with the provider. Every finding requires human
# review and never mutates an authoritative project record.
PRECONSTRUCTION_COMPARISON_MAX_ASSERTIONS=2000
PRECONSTRUCTION_COMPARISON_MAX_CANDIDATES=500
PRECONSTRUCTION_COMPARISON_MAX_FINDINGS=500
PRECONSTRUCTION_COMPARISON_MAX_ASSERTION_LINKS=20
PRECONSTRUCTION_COMPARISON_MAX_EVIDENCE_PER_FINDING=20
PRECONSTRUCTION_COMPARISON_MAX_MANUAL_FINDINGS=500
PRECONSTRUCTION_COMPARISON_MAX_PLANS=50
PRECONSTRUCTION_COMPARISON_REQUEST_MAX_CHARACTERS=100000
PRECONSTRUCTION_COMPARISON_MAX_RESULT_BYTES=1048576
PRECONSTRUCTION_COMPARISON_MAX_TITLE_CHARACTERS=200
PRECONSTRUCTION_COMPARISON_MAX_SUMMARY_CHARACTERS=600
PRECONSTRUCTION_COMPARISON_MAX_RATIONALE_CHARACTERS=2000
PRECONSTRUCTION_COMPARISON_MAX_REVIEWER_NOTE_CHARACTERS=2000
PRECONSTRUCTION_COMPARISON_FINDING_PAGE_SIZE=25
PRECONSTRUCTION_COMPARISON_FINDING_MAX_PAGE_SIZE=100
PRECONSTRUCTION_COMPARISON_PLAN_PAGE_SIZE=50
# Match class a coverage assertion must reach before a requirement counts as
# covered: exact, strong, or partial.
PRECONSTRUCTION_COMPARISON_COVERED_MINIMUM_MATCH_CLASS=strong

# Human-initiated follow-up actions raised from accepted findings (M18.5).
# These bound a purely human workflow: there is no worker, no cron, no
# provider, and no credential.
PRECONSTRUCTION_FOLLOW_UP_MAX_PER_FINDING=6
PRECONSTRUCTION_FOLLOW_UP_MAX_PER_PLAN=500
PRECONSTRUCTION_FOLLOW_UP_MAX_TITLE_CHARACTERS=200
PRECONSTRUCTION_FOLLOW_UP_MAX_BODY_CHARACTERS=4000
PRECONSTRUCTION_FOLLOW_UP_MAX_CLOSURE_NOTE_CHARACTERS=2000
PRECONSTRUCTION_FOLLOW_UP_PAGE_SIZE=25
PRECONSTRUCTION_FOLLOW_UP_MAX_PAGE_SIZE=100

# Bounded execution, batching, diagnostics, and cost accounting (M18.6).
# The pair budget is the exact number of requirement/coverage comparisons a
# deterministic run would perform; exceeding it blocks readiness and refuses
# the run rather than silently comparing a truncated population.
PRECONSTRUCTION_EXECUTION_MAX_COMPARISON_PAIRS=1000000
PRECONSTRUCTION_EXECUTION_PERSIST_CHUNK_SIZE=500
# Must not exceed either lease window: a batch that outlives its lease could
# still be working on an attempt another worker has already recovered.
PRECONSTRUCTION_EXECUTION_WORKER_MAX_RUNTIME_SECONDS=240
PRECONSTRUCTION_EXECUTION_FINDING_EVIDENCE_LIMIT=10
PRECONSTRUCTION_EXECUTION_FINDING_MAX_EVIDENCE_LIMIT=20
PRECONSTRUCTION_EXECUTION_METRICS_RETENTION_ROWS=500
PRECONSTRUCTION_EXECUTION_METRICS_ENABLED=True
PRECONSTRUCTION_EXECUTION_DIAGNOSTICS_ENABLED=True
# Cost rates in integer micro-units per billable unit. Zero means no rate is
# configured, and cost is then reported as absent rather than as zero, so an
# operator is never shown a fabricated figure. No currency is implied.
PRECONSTRUCTION_EXECUTION_COST_INPUT_MICROS_PER_UNIT=0
PRECONSTRUCTION_EXECUTION_COST_OUTPUT_MICROS_PER_UNIT=0
